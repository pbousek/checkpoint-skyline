# Caddy TLS -- tri mozne rezimy, odkomentuj ten ktery odpovida tvemu prostredi:

# 1) Let's Encrypt (vychozi)
#    Vyzaduje verejnou IP, DNS zaznam pro domenu a otevrene porty 80+443 z internetu.
#    Caddy certifikat ziska a obnovuje automaticky.
{$GRAFANA_DOMAIN} {
    reverse_proxy grafana:3000
}

# 2) Interni CA (bez verejne IP)
#    Caddy si vytvori vlastni lokalni CA a certifikat podepise sam.
#    Certifikat bude v prohlizeci neduveryhodny -- je potreba pridat Caddy root CA
#    do trust store systemu/prohlizece (najdes ji v Docker volume caddy_data).
#
# {$GRAFANA_DOMAIN} {
#     tls internal
#     reverse_proxy grafana:3000
# }

# 3) Vlastni certifikat (interni PKI, self-signed)
#    Certifikat a klic musi byt namountovane v kontejneru.
#    Pridej do docker-compose.yml do volumes Caddy service:
#      - ./certs/grafana.crt:/etc/caddy/certs/grafana.crt:ro
#      - ./certs/grafana.key:/etc/caddy/certs/grafana.key:ro
#
# {$GRAFANA_DOMAIN} {
#     tls /etc/caddy/certs/grafana.crt /etc/caddy/certs/grafana.key
#     reverse_proxy grafana:3000
# }
