# Verze images -- "latest" nebo konkretni tag (napr. "v3.4.0")
PROMETHEUS_VERSION=latest
GRAFANA_VERSION=latest
CADDY_VERSION=latest
# ALERTMANAGER_VERSION=latest

# Porty
PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000      # jen pokud nepouzivas Caddy
# ALERTMANAGER_PORT=9093

# Prometheus retention
PROMETHEUS_RETENTION=90d
PROMETHEUS_RETENTION_SIZE=10GB

# Grafana
# GRAFANA_ROOT_URL se odvozuje automaticky jako https://${GRAFANA_DOMAIN}
GRAFANA_DOMAIN=monitoring.example.com
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

# Caddy TLS -- pouziva setup.sh pro generovani Caddyfile
# Moznosti: letsencrypt, internal, custom
#   letsencrypt  -- automaticky certifikat (vyzaduje verejnou IP + DNS)
#   internal     -- Caddy si vygeneruje vlastni CA (interni sit, bez verejne IP)
#   custom       -- vlastni certifikat (setup.sh vygeneruje self-signed do certs/grafana.*)
CADDY_TLS_MODE=internal

# Prometheus -- pouziva setup.sh pro generovani web.yml a payload.json
PROMETHEUS_SERVER=10.0.0.42
PROMETHEUS_AUTH_USER=skyline
PROMETHEUS_AUTH_PASSWORD=changeme
