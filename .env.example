# Image versions -- "latest" or a specific tag (e.g. "v3.4.0")
PROMETHEUS_VERSION=latest
GRAFANA_VERSION=latest
CADDY_VERSION=latest
# ALERTMANAGER_VERSION=latest

# Ports
PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000      # only if not using Caddy
# ALERTMANAGER_PORT=9093

# Prometheus retention
PROMETHEUS_RETENTION=90d
PROMETHEUS_RETENTION_SIZE=10GB

# Grafana
# GF_SERVER_ROOT_URL is derived automatically as https://${GRAFANA_DOMAIN}
GRAFANA_DOMAIN=monitoring.example.com
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

# Caddy TLS -- used by setup.sh to generate Caddyfile
# Options: letsencrypt, internal, custom
#   letsencrypt  -- automatic certificate (requires public IP + DNS)
#   internal     -- Caddy generates its own local CA (internal network, no public IP)
#   custom       -- own certificate (setup.sh generates self-signed into certs/grafana.*)
CADDY_TLS_MODE=internal

# Prometheus -- used by setup.sh to generate web.yml and payload.json
PROMETHEUS_SERVER=10.0.0.42
PROMETHEUS_AUTH_USER=skyline
PROMETHEUS_AUTH_PASSWORD=changeme
